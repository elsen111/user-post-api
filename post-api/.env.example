# ============================================================
# Application
# ============================================================

APP_NAME=post-api
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default


# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=post_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

POSTGRES_PORT=5432


# ============================================================
# Spring Datasource
# ============================================================

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blog_api
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me


# ============================================================
# JWT
# ============================================================

# Must be a Base64-encoded secret containing at least 32 bytes.
# Generate your own secret for real usage.

JWT_SECRET=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_SECRET

JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# ============================================================
# Rate Limiting
# ============================================================

RATE_LIMIT_ENABLED=true

# General API:
# 100 requests per 60 seconds per IP
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_DURATION_SECONDS=60

# Authentication endpoints:
# 10 requests per 60 seconds per IP
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_REFILL_TOKENS=10
AUTH_RATE_LIMIT_REFILL_DURATION_SECONDS=60